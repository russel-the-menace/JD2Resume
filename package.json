{
  "name": "draftline-resume-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-with-remote-db.mjs dev",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "dev:remote-db": "node scripts/run-with-remote-db.mjs dev",
    "build": "vite build",
    "preview": "node scripts/run-with-remote-db.mjs preview",
    "preview:remote-db": "node scripts/run-with-remote-db.mjs preview",
    "check:types": "tsc --noEmit",
    "check:puppet": "tsx scripts/verify-puppet-pipeline.mts",
    "check:layout": "tsx scripts/verify-puppet-layout.mts",
    "check:renderer": "tsx scripts/verify-renderer.mts",
    "check:renderer-contract": "tsx scripts/verify-renderer-contract.mts",
    "check:renderer-migration": "tsx scripts/verify-renderer-migration.mts",
    "check:renderer-parity": "tsx scripts/verify-renderer-pdf-parity.mts",
    "check:renderer-live": "tsx scripts/verify-renderer-live.mts",
    "check:profile-import": "tsx scripts/verify-profile-import.mts",
    "check:ui": "tsx scripts/verify-ui.mts",
    "check:commit-message": "node scripts/validate-commit-message.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.2.8",
    "lucide-react": "0.563.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "postgres": "3.4.7",
    "puppeteer": "25.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright-core": "^1.61.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "8.1.5"
  }
}
