# Gemini relay / compatible endpoint
GEMINI_API=

# Primary generation model. Upgrade from Lite for final resume quality.
GEMINI_PRIMARY_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_ESCALATION_MODEL=gemini-3.1-pro-preview

# OpenAI-compatible relay only. The service never calls api.openai.com directly.
OPENAI_RELAY_BASE_URL=
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-5.4-mini
